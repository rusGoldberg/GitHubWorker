<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.githubclient.controllers.LoginController" alignment="CENTER" spacing="10.0">
    <Text fx:id="errorMessage" style="-fx-text-fill: red;"/>
    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    <Button fx:id="loginButton" text="Login" onAction="#handleLogin"/>
</VBox>

<!--1. Корневой элемент VBox:-->
<!--xmlns:fx="http://javafx.com/fxml/1": Объявление пространства имен для FXML.-->
<!--fx:controller="com.githubclient.controllers.LoginController": Указывает контроллер, который будет управлять этим интерфейсом.-->
<!--alignment="CENTER": Выравнивание элементов по центру.-->
<!--spacing="10.0": Расстояние между элементами.-->

2. Элементы интерфейса:
<Text fx:id="errorMessage" style="-fx-text-fill: red;"/>: Текстовое поле для отображения сообщений об ошибках. Использует красный цвет текста.
<TextField fx:id="usernameField" promptText="Username"/>: Поле для ввода имени пользователя с подсказкой.
<PasswordField fx:id="passwordField" promptText="Password"/>: Поле для ввода пароля с подсказкой.
<Button fx:id="loginButton" text="Login" onAction="#handleLogin"/>: Кнопка для входа в систему. При нажатии вызывает метод handleLogin в контроллере.
*/
