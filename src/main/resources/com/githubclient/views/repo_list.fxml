<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.githubclient.controllers.RepoController" alignment="CENTER" spacing="10.0">
    <ListView fx:id="repoListView"/>
</VBox>
/*
1. Корневой элемент VBox:
fx:controller="com.githubclient.controllers.RepoController": Указывает контроллер, который будет управлять этим интерфейсом.
alignment="CENTER": Выравнивание элементов по центру.
spacing="10.0": Расстояние между элементами.

*/
